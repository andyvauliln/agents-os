      "header-view": {
        "mount": "#header-view",
        "html": "<div class=\"hv\">\n  <button class=\"hv-btn\" data-shown=\"${e(d.rundown_button.shown_on)}\" aria-expanded=\"${d.rundown_button.open}\" aria-label=\"Rundown\" title=\"Rundown\">&#9776;</button>\n  <button class=\"hv-btn\" aria-label=\"Back\" title=\"Back\">&larr;</button>\n  <div class=\"hv-brand\"><span class=\"hv-lamp${d.brand.recording_lamp ? ' on' : ''}\" title=\"Recording ${d.brand.recording_lamp ? 'on' : 'off'}\"></span>${e(d.brand.name)}</div>\n  <div class=\"hv-conns\">${Object.keys(d.connections).map(k => `<span class=\"hv-conn\" data-key=\"${e(k)}\" title=\"${e(d.connections[k].detail)}\"><i class=\"hv-dot ${e(d.connections[k].state)}\"></i>${e(d.connections[k].label)}<em class=\"${e(d.connections[k].state)}\">${e(d.connections[k].state)}</em></span>`).join('')}</div>\n  <span class=\"hv-model\" data-shown=\"${e(d.model_chip.shown_on)}\">${e(d.model_chip.text)}</span>\n  <button class=\"hv-btn\" aria-pressed=\"${d.docs_button.pressed}\" title=\"Docs\">Docs</button>\n  <button class=\"hv-btn hv-badged\" aria-pressed=\"${d.notifications_button.pressed}\" aria-label=\"Notifications, ${d.notifications_button.count} new\" title=\"Notifications\">&#9993;${d.notifications_button.count ? `<b>${d.notifications_button.count}</b>` : ''}</button>\n  <button class=\"hv-btn hv-badged\" aria-pressed=\"${d.apps_button.pressed}\" title=\"Profiles and apps\">Apps<b>${e(d.apps_button.profile_badge)}</b></button>\n  <button class=\"hv-btn\" title=\"Theme: ${e(d.theme_button.theme)}\">&#9680; ${e(d.theme_button.theme)}</button>\n  <button class=\"hv-btn hv-state\" id=\"state-button\" aria-pressed=\"${d.state_button.pressed}\" data-call=\"local.open.state-view\" title=\"State view\">{ } State</button>\n</div>",
        "css": ".hv{display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-height:40px}\n.hv-btn{position:relative;padding:6px 10px;border-radius:7px;border:1px solid var(--line);background:var(--panel);color:var(--fg);cursor:pointer;font-size:13px;white-space:nowrap}\n.hv-btn[aria-pressed=\"true\"]{background:var(--sel);border-color:var(--accent);color:var(--accent)}\n.hv-badged b{position:absolute;top:-6px;right:-6px;min-width:16px;height:16px;padding:0 4px;box-sizing:border-box;border-radius:8px;background:var(--accent);color:var(--on-accent);font:600 10px/16px var(--sans)}\n.hv-brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:16px;margin-right:4px}\n.hv-lamp{width:9px;height:9px;border-radius:50%;background:var(--line)}\n.hv-lamp.on{background:var(--del);box-shadow:0 0 0 3px var(--del-bg)}\n.hv-conns{display:flex;gap:6px;flex-wrap:wrap;margin-right:auto}\n.hv-conn{display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:4px 8px;border-radius:99px;background:var(--gutter);border:1px solid var(--line);cursor:default}\n.hv-conn em{font:600 10px var(--sans);text-transform:uppercase;letter-spacing:.06em;font-style:normal;color:var(--muted)}\n.hv-dot{width:7px;height:7px;border-radius:50%;background:var(--muted)}\n.hv-dot.ok{background:var(--add)}.hv-dot.mock{background:var(--upd)}.hv-dot.off{background:var(--muted)}\n.hv-conn em.ok{color:var(--add)}.hv-conn em.mock{color:var(--upd)}\n.hv-model{font:12px var(--mono);color:var(--muted);padding:4px 8px;border:1px dashed var(--line);border-radius:6px}\n[data-shown=\"desktop\"]{display:none}\n@media (min-width:1024px){[data-shown=\"desktop\"]{display:inline-flex}[data-shown=\"tablet and phone\"]{display:none}}",
