        "performance": {},
        "code": "const view = os.get(input);\nif (!view) throw new Error('No view at ' + input);\nconst root = document.querySelector(view.mount);\nif (!root) throw new Error('No element for ' + view.mount);\nos.style(input, view.css || '');\nroot.innerHTML = os.template(view.html || '', view['ui-data'] || {});\nos.bind(root, input);\nroot.hidden = false;\nos.setMounted(input, true);\nif (view.functions && view.functions['local.init']) await os.call('local.init', {}, input, ctx.id);\nreturn { view: input, mount: view.mount, elements: root.querySelectorAll('*').length };",
