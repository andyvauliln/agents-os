        "code": "const view = os.get(input);\nif (!view) throw new Error('No view at ' + input);\nconst id = input.split('.').pop();\nconst root = document.getElementById(id);\nif (!root) throw new Error('No element #' + id);\nroot.innerHTML = os.template(view.html || '', view['ui-data'] || {});\nos.bind(root, input);\nroot.hidden = false;\nos.setMounted(input, true);\nif (view.functions && view.functions['local.init']) await os.call('local.init', {}, input, ctx.id);\nreturn { view: input, elements: root.querySelectorAll('*').length };",
