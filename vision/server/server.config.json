{
 "_about": "Settings of the project IDE server. Paths are relative to the top of the repository. While we plan, the server runs from the planning folder vision/ (the page in vision/explorer/, the drafts and How it works files in vision/); when the repository gets apps/project-IDE/ and agents/system/, these paths change to them. No secret values here: the keys are named, and their values stay in the keys file on this machine.",
 "repo": "../..",
 "host": "127.0.0.1",
 "port": 8765,
 "page_dir": "vision/explorer",
 "page": "file-tree-explorer.html",
 "data": "file-tree.data.json",
 "store_dir": "vision/page-store",
 "write_through": true,
 "log_dir": "vision/logs/project-ide-agent",
 "secrets": {
  "file": ".secrets/test/.env",
  "keys": [
   "ANTHROPIC_API_KEY",
   "GROQ_API_KEY"
  ]
 },
 "voice": {
  "_about": "Voice input for the request boxes (voice.py): Groq speech to text. Models are tried in order; one that hits a rate limit or fails is skipped for the next. The key's value stays in the keys file.",
  "url": "https://api.groq.com/openai/v1/audio/transcriptions",
  "models": [
   "whisper-large-v3-turbo",
   "whisper-large-v3"
  ],
  "key": "GROQ_API_KEY",
  "max_seconds": 300,
  "language": null
 },
 "claude": {
  "cwd": "vision",
  "model": null,
  "max_turns": 80,
  "max_budget_usd": 3,
  "approval_timeout_s": 900,
  "allow": [
   "Read",
   "Glob",
   "Grep",
   "LS",
   "Edit",
   "Write",
   "MultiEdit",
   "NotebookEdit",
   "TodoWrite",
   "Task",
   "Agent",
   "Skill",
   "WebSearch",
   "WebFetch",
   "Bash(cd *)",
   "Bash(python3 *)",
   "Bash(node *)",
   "Bash(ls *)",
   "Bash(cat *)",
   "Bash(head *)",
   "Bash(tail *)",
   "Bash(wc *)",
   "Bash(grep *)",
   "Bash(rg *)",
   "Bash(find *)",
   "Bash(mkdir *)",
   "Bash(cp *)",
   "Bash(mv *)",
   "Bash(jq *)",
   "Bash(diff *)",
   "Bash(git status*)",
   "Bash(git ls-files*)",
   "Bash(git grep*)",
   "Bash(git diff*)",
   "Bash(git log*)",
   "Bash(git show*)",
   "Bash(git add *)",
   "Bash(git commit *)",
   "Bash(git pull*)",
   "Bash(git fetch*)",
   "Bash(git merge *)"
  ],
  "ask_owner": [
   "git push",
   "git reset",
   "git rebase",
   "git checkout --",
   "git clean",
   "rm ",
   "rmdir ",
   "chmod ",
   "chown ",
   "sudo ",
   "curl ",
   "wget ",
   "pip install",
   "npm install",
   "kill "
  ],
  "never": [
   ".secrets"
  ]
 },
 "planning_dir": "vision"
}